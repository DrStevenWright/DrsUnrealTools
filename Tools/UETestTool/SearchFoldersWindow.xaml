<Window x:Class="UETestTool.SearchFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search folders"
        Icon="Assets/UETestTool.ico"
        Width="620" Height="400" MinWidth="460" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="The tool looks for projects only in these folders, and up to three levels below them. Projects elsewhere can be added with Browse…." />

        <ListBox Grid.Row="1" x:Name="FolderList" SelectionMode="Extended" AutomationProperties.Name="Search folders"
                 SelectionChanged="FolderList_SelectionChanged" KeyDown="FolderList_KeyDown" />
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
            <Button Content="Add…" Click="Add_Click" MinWidth="90" Margin="0,0,0,8" AutomationProperties.Name="Add folder" />
            <Button Content="Remove" Click="Remove_Click" MinWidth="90" x:Name="RemoveButton" IsEnabled="False" />
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource DimText}" Margin="0,6,0,0"
                   Text="Removing a folder removes its projects from the list. To hide a single project, right-click it in the project list." />

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click" MinWidth="90" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
