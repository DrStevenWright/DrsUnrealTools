<Window x:Class="UETestTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UETestTool"
        xmlns:vm="clr-namespace:UETestTool.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="UE Test Tool"
        Icon="Assets/UETestTool.ico"
        Width="980" Height="660" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- The list's last column (✎ and 🗑), as wide as the New button above it, so "Your extra arguments" ends
             where the New button starts and sits halfway between the Arguments column and that button. -->
        <GridLength x:Key="ActionsColumnWidth">100</GridLength>

        <!-- Right-click menu for project list items. Defined here (not inside the item style) because WPF can't
             wire event handlers declared inside a Setter value. -->
        <ContextMenu x:Key="ProjectContextMenu" x:Shared="False">
            <MenuItem Header="Remove from list" Click="RemoveProject_Click" />
        </ContextMenu>
        <ContextMenu x:Key="LaunchItemContextMenu" x:Shared="False">
            <MenuItem Header="Copy command line" Click="CopyCommandLine_Click"
                      ToolTip="Copy the full command line (for a session, the server's and each client's) to the clipboard." />
        </ContextMenu>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- project -->
            <RowDefinition Height="Auto" />   <!-- engine -->
            <RowDefinition Height="Auto" />   <!-- engine warning -->
            <RowDefinition Height="Auto" />   <!-- map -->
            <RowDefinition Height="Auto" />   <!-- configs header -->
            <RowDefinition Height="*" />      <!-- configs -->
            <RowDefinition Height="Auto" />   <!-- config warnings -->
            <RowDefinition Height="Auto" />   <!-- launch bar -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Project -->
        <TextBlock Grid.Row="0" Text="Project" Style="{StaticResource LabelText}" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ProjectBox" Margin="0,0,8,0"
                  ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                  ToolTip="Projects found in your search folders (Folders…) and added with Browse…. Right-click a project in the list to remove it.">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                    <Setter Property="ToolTip" Value="{Binding Path}" />
                    <Setter Property="ContextMenu" Value="{StaticResource ProjectContextMenu}" />
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:ProjectItem">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource DimText}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
            <Button Content="Browse…" Command="{Binding BrowseCommand}" Margin="0,0,8,0"
                    ToolTip="Add a .uproject file that wasn't found automatically." />
            <Button Content="Folders…" Command="{Binding EditSearchFoldersCommand}" Margin="0,0,8,0" AutomationProperties.Name="Folders"
                    ToolTip="Choose folders to search for projects, e.g. your repos folder." />
            <Button Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh" MinWidth="0"
                    ToolTip="Refresh (F5): search again for engines, projects and maps, and re-read the project's config files.">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
            </Button>
        </StackPanel>

        <!-- Engine -->
        <TextBlock Grid.Row="1" Text="Engine" Style="{StaticResource LabelText}" Margin="0,10,12,0" />
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,8,0"
                  ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                    <Setter Property="ToolTip" Value="{Binding EditorExe}" />
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ToolTip>
                <TextBlock Text="{Binding SelectedEngine.EditorExe, FallbackValue='No engine selected'}" />
            </ComboBox.ToolTip>
        </ComboBox>

        <!-- Engine mismatch warning -->
        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="12,6" CornerRadius="4"
                Background="#33D9A400" BorderBrush="#88D9A400" BorderThickness="1"
                Visibility="{Binding EngineWarning, Converter={StaticResource NotEmptyToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Switch" Command="{Binding SwitchEngineCommand}" Padding="12,2"
                        Visibility="{Binding SuggestedEngine, Converter={StaticResource NotEmptyToVisibility}}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" />
                    <Run Text=" " /><Run Text="{Binding EngineWarning, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Map -->
        <TextBlock Grid.Row="3" Text="Map" Style="{StaticResource LabelText}" Margin="0,10,12,0" />
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,10,8,0"
                  ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}" IsEnabled="{Binding IsMapEnabled}"
                  IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                  ToolTip="With the list focused, type the start of a map's name to jump to it.">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding PackagePath}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding MapHint}" Style="{StaticResource DimText}"
                   VerticalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="220" />

        <!-- Configurations -->
        <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="0,14,0,6" x:Name="ConfigHeader">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="ArgsColumn" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource ActionsColumnWidth}" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Configuration" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Arguments" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
            <TextBlock Grid.Column="3" Text="Your extra arguments" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                       ToolTip="Added after the configuration's arguments. Saved per configuration, just for you, in the project's Saved folder." />
            <Button Grid.Column="4" Margin="8,0,0,0" HorizontalContentAlignment="Center" Click="NewMenu_Click" AutomationProperties.Name="New"
                    ToolTip="Add a configuration or session, or open the project's Config/UETestTool.ini.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="New" />
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="8,1,0,0" />
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="New configuration…" Command="{Binding NewConfigCommand}"
                                  ToolTip="A configuration based on another (the selected one, to start with), with its own arguments." />
                        <MenuItem Header="New session…" Command="{Binding NewSessionCommand}"
                                  ToolTip="A server and any mix of clients, launched together." />
                        <Separator />
                        <MenuItem Header="Open UETestTool.ini" Command="{Binding OpenConfigFileCommand}"
                                  ToolTip="Open the project's Config/UETestTool.ini, where configurations and sessions are saved." />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <ListBox Grid.Row="5" Grid.ColumnSpan="3" x:Name="ConfigList" ItemsSource="{Binding LaunchItemsView}" SelectedItem="{Binding SelectedItem}"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False" AutomationProperties.Name="Configurations"
                 MouseDoubleClick="Configs_MouseDoubleClick" PreviewGotKeyboardFocus="Configs_PreviewGotKeyboardFocus"
                 SelectionChanged="Configs_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="0,2" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="ContextMenu" Value="{StaticResource LaunchItemContextMenu}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,12,0,4">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,10,0"
                                           ToolTip="Multiplayer sessions: a server, then its clients once the server is listening." />
                                <Separator VerticalAlignment="Center" Opacity="0.5" />
                            </DockPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.Resources>
                <DataTemplate DataType="{x:Type vm:ConfigItem}">
                    <Grid ToolTip="{Binding RuleDescription}" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ArgsColumn" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource ActionsColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" IsHitTestVisible="False" Focusable="False" MinWidth="0" Margin="8,0,0,0"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Args}" VerticalAlignment="Center" Margin="0,0,24,0" MaxWidth="420" Style="{StaticResource DimText}"
                                   TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                        <TextBox Grid.Column="3" Text="{Binding CustomArgs, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalContentAlignment="Center" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="&#xE70F;"
                                    ToolTip="Edit (or copy) this configuration in the row below"
                                    Command="{Binding DataContext.EditConfigCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                    ToolTip="Delete from Config/UETestTool.ini"
                                    Visibility="{Binding IsProjectDefined, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding DataContext.DeleteConfigCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:SessionItem}">
                    <Grid ToolTip="{Binding ToolTip}" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource ActionsColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" IsHitTestVisible="False" Focusable="False" MinWidth="0" Margin="8,0,0,0"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding RowText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DimText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="#E0A000" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="&#xE70F;"
                                    ToolTip="Edit (or copy) this session"
                                    Command="{Binding DataContext.EditSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                    ToolTip="Delete from Config/UETestTool.ini"
                                    Visibility="{Binding IsProjectDefined, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#E0A000"
                   Text="{Binding ConfigWarnings}"
                   Visibility="{Binding ConfigWarnings, Converter={StaticResource NotEmptyToVisibility}}" />

        <!-- Status + launch -->
        <DockPanel Grid.Row="7" Grid.ColumnSpan="3" Margin="0,16,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Command="{Binding LaunchCommand}" Padding="22,8" FontSize="15"
                    AutomationProperties.Name="Launch" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000"
                    Style="{DynamicResource AccentButtonStyle}" IsDefault="False">
                <Button.ToolTip>
                    <ToolTip MaxWidth="900">
                        <TextBlock Text="{Binding CommandPreview}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    </ToolTip>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Launch" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding StopCommand}" Padding="14,8" FontSize="15" Margin="0,0,8,0"
                    AutomationProperties.Name="Stop" ToolTip="{Binding StopToolTip}" ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StopText}" />
                </StackPanel>
            </Button>
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="4" Margin="0,0,12,0"
                         VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DimText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="#E05050" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
