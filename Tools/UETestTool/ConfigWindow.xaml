<Window x:Class="UETestTool.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration"
        Icon="Assets/UETestTool.ico"
        Width="620" SizeToContent="Height" MinWidth="460" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,10,12,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- name -->
            <RowDefinition Height="Auto" />   <!-- template -->
            <RowDefinition Height="Auto" />   <!-- template hint -->
            <RowDefinition Height="Auto" />   <!-- arguments -->
            <RowDefinition Height="Auto" />   <!-- error -->
            <RowDefinition Height="Auto" />   <!-- buttons -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,12,0" />
        <TextBox Grid.Column="1" x:Name="NameBox" AutomationProperties.Name="Configuration name" TextChanged="Changed" />

        <TextBlock Grid.Row="1" Text="Template" Style="{StaticResource Label}" x:Name="TemplateLabel" />
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TemplateBox" Margin="0,10,0,0" DisplayMemberPath="Name"
                  AutomationProperties.Name="Template" SelectionChanged="Template_SelectionChanged" />
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BasedOnText" Margin="0,10,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TemplateHint" Style="{StaticResource DimText}" Margin="0,4,0,0" />

        <TextBlock Grid.Row="3" Text="Arguments" Style="{StaticResource Label}" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="ArgsBox" Margin="0,10,0,0" AutomationProperties.Name="Arguments"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalContentAlignment="Center" TextChanged="Changed" />

        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ErrorText" Foreground="#E05050" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed" />

        <DockPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,20,0,0">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DimText}" VerticalAlignment="Center" MaxWidth="300"
                       Text="Saved to the project's Config/UETestTool.ini, shared with everyone using the project." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" IsDefault="True" Click="Save_Click" MinWidth="90" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" IsCancel="True" MinWidth="90" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
